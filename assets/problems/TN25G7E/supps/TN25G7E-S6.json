    "Title": "Passage 2: The Green Corn Dance: San Ildefonso¹",
    "Subtitle": "",
    "Author": "by Alice Corbin",
    "LabelType": "L",
    "Content": [
        [" ", "Far in the east"],
        [" ", "The gods beat"],
        [" ", "On thunder drums...\n\n"],
        [" ", "With rhythmic thud"],
        ["5", "The dancers' feet"],
        [" ", "Answer the beat"],
        [" ", "Of the thunder drums.\n\n"],
        [" ", "Eagle feather"],
        [" ", "On raven hair,"],
        ["10", "With bright tablita's²"],
        [" ", "Turquoise glare.\n\n"],
        [" ", "Tasselled corn"],
        [" ", "Stands tall and fair"],
        [" ", "From rain-washed roots"],
        ["15", "Through lambent³ air.\n\n"],
        [" ", "Corn springs up"],
        [" ", "From the seed in the ground,"],
        [" ", "The cradled corn"],
        [" ", "By the sun is found.\n\n"],
        ["20", "Eagle feather"],
        [" ", "And turkey plume"],
        [" ", "From the wind-swept cloud"],
        [" ", "Bring rain and gloom.\n\n"],
        [" ", "Hid in the cloud"],
        ["25", "The wind brings rain"],
        [" ", "And the water-song"],
        [" ", "To the dust-parched plain.\n\n"],
        [" ", "Far in the `text(east)`"],
        [" ", "The gods retreat"],
        ["30", "As the thunder drums"],
        [" ", "Grow small and sweet.\n\n"],
        [" ", "The dancers' feet"],
        [" ", "Echo the sound"],
        [" ", "As the drums grow faint"],
        ["35", "And the rain comes down."]
    ],
